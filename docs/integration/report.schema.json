{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AyinkxLab/soroban-security-scanner/docs/integration/report.schema.json",
  "title": "soroban-scan JSON report",
  "description": "Machine-readable security report emitted by `soroban-scan scan --format json`. The stable integration contract for downstream consumers such as the Stellar Contract Observatory.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "project",
    "stats",
    "effective_config",
    "findings",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the report contract, independent of the tool version.",
      "const": "1"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "information_uri"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "information_uri": { "type": "string" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["root", "kind", "source_files", "soroban_sdk_versions"],
      "properties": {
        "root": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["generic_rust", "likely_soroban", "confirmed_soroban"]
        },
        "source_files": { "type": "integer", "minimum": 0 },
        "soroban_sdk_versions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": [
        "files_analyzed",
        "rules_run",
        "rules_skipped",
        "findings_raw",
        "findings_rejected"
      ],
      "properties": {
        "files_analyzed": { "type": "integer", "minimum": 0 },
        "rules_run": { "type": "integer", "minimum": 0 },
        "rules_skipped": { "type": "integer", "minimum": 0 },
        "findings_raw": { "type": "integer", "minimum": 0 },
        "findings_rejected": { "type": "integer", "minimum": 0 },
        "suppressions_detected": {
          "type": "integer",
          "minimum": 0,
          "description": "Inline suppression directives detected in the analyzed sources."
        },
        "findings_suppressed": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings excluded from the gate by an inline suppression directive."
        }
      },
      "additionalProperties": true
    },
    "effective_config": {
      "description": "Effective, serializable scan configuration used to produce this report. Contains no environment data or secrets.",
      "type": "object",
      "required": [
        "min_severity",
        "min_confidence",
        "exclude",
        "follow_symlinks",
        "rules",
        "ai"
      ],
      "properties": {
        "min_severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "min_confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "follow_symlinks": { "type": "boolean" },
        "rules": {
          "type": "object",
          "required": [
            "disabled",
            "enabled",
            "severity_overrides",
            "confidence_overrides"
          ],
          "properties": {
            "disabled": { "type": "array", "items": { "type": "string" } },
            "enabled": { "type": "array", "items": { "type": "string" } },
            "severity_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["info", "low", "medium", "high", "critical"]
              }
            },
            "confidence_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            }
          },
          "additionalProperties": true
        },
        "ai": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "description": "Findings that reach the failure gate. Suppressed findings are reported in `suppressed` instead.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "title",
          "description",
          "severity",
          "confidence",
          "category",
          "location",
          "evidence",
          "remediation",
          "references",
          "fingerprint"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^SS-[0-9]{3}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "category": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "end_column": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } },
          "fingerprint": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "truncation": {
      "description": "Present only when the report was bounded with `--max-findings`. The failure gate is evaluated before truncation.",
      "type": "object",
      "required": ["shown", "total", "omitted"],
      "properties": {
        "shown": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "omitted": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "suppressed": {
      "description": "Findings excluded from the gate by an inline suppression directive. Never silently dropped: each entry carries the finding plus the directive that suppressed it and, when given, the reason.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "location", "suppression"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^SS-[0-9]{3}$" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "category": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "end_column": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } },
          "fingerprint": { "type": "string" },
          "suppression": {
            "type": "object",
            "required": ["file", "line", "rules"],
            "properties": {
              "file": {
                "type": "string",
                "description": "Root-relative path (forward slashes) of the file containing the directive."
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "description": "1-based line of the directive comment."
              },
              "rules": {
                "type": "string",
                "description": "Rule targets of the directive, for example `SS-001,SS-002` or `all`."
              },
              "reason": {
                "type": "string",
                "description": "Reason supplied by the directive, when present."
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "suppressions": {
      "description": "Every inline suppression directive detected during the scan, including directives that matched no finding (`applied` is false), so suppression usage stays auditable.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "rules", "start_line", "end_line", "applied"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "rules": { "type": "string" },
          "reason": { "type": "string" },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "applied": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
