{
  "components": {
    "headers": {
      "Retry-After": {
        "description": "Seconds the client should wait before retrying a rate-limited request.",
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "X-RateLimit-Limit": {
        "description": "Maximum requests permitted in the current rate-limit window.",
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "X-RateLimit-Remaining": {
        "description": "Remaining requests permitted in the current rate-limit window.",
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "X-RateLimit-Reset": {
        "description": "Seconds remaining until the rate-limit window resets.",
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The request payload or parameters failed validation."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The requested job or rule identifier does not exist or has expired."
      },
      "PayloadTooLarge": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The submitted source payload exceeds the configured size or file-count limit."
      },
      "ServiceUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "The bounded job store is at capacity and cannot accept new work."
      },
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "Per-token rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          },
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/X-RateLimit-Limit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/X-RateLimit-Remaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/X-RateLimit-Reset"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "Missing or invalid bearer authentication token."
      }
    },
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "Structured error response returned by all non-2xx endpoints.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error code (for example `auth_required`, `rate_limited`, `store_full`, `invalid_request`).",
            "type": "string"
          },
          "message": {
            "description": "Human-readable error summary free of secrets and internal paths.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Diagnostic": {
        "additionalProperties": true,
        "description": "Structured diagnostic message emitted during discovery or parsing.",
        "properties": {
          "level": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "level",
          "message"
        ],
        "type": "object"
      },
      "Finding": {
        "additionalProperties": true,
        "description": "A deterministic, evidence-backed security finding matching `docs/integration/report.schema.json`.",
        "properties": {
          "category": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/SourceLocation"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "remediation": {
            "type": "string"
          },
          "rule_id": {
            "pattern": "^SS-[0-9]{3}$",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "title",
          "description",
          "severity",
          "confidence",
          "category",
          "location",
          "evidence",
          "remediation",
          "references",
          "fingerprint"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Service liveness and version status.",
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "tool": {
            "const": "soroban-scan",
            "type": "string"
          },
          "version": {
            "description": "Semantic version of the running scanner.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "tool",
          "version"
        ],
        "type": "object"
      },
      "RuleDetail": {
        "additionalProperties": false,
        "description": "Metadata and remediation guidance for a security detector.",
        "properties": {
          "category": {
            "type": "string"
          },
          "default_confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "default_severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "pattern": "^SS-[0-9]{3}$",
            "type": "string"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "remediation": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "default_severity",
          "default_confidence",
          "category",
          "remediation",
          "references"
        ],
        "type": "object"
      },
      "RuleListResponse": {
        "additionalProperties": false,
        "description": "Catalog of registered security detectors.",
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleDetail"
            },
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "type": "object"
      },
      "ScanJobRequest": {
        "additionalProperties": false,
        "description": "Bounded asynchronous scan job submission payload.",
        "properties": {
          "scan": {
            "$ref": "#/components/schemas/ScanRequest"
          },
          "ttl_seconds": {
            "description": "Optional retention TTL in seconds for the completed job record (bounded by the server maximum).",
            "maximum": 86400,
            "minimum": 60,
            "type": "integer"
          }
        },
        "required": [
          "scan"
        ],
        "type": "object"
      },
      "ScanJobStatus": {
        "additionalProperties": false,
        "description": "Lifecycle state of an asynchronous scan job.",
        "properties": {
          "created_at": {
            "description": "UTC creation timestamp (`YYYY-MM-DDTHH:MM:SSZ`).",
            "type": "string"
          },
          "error": {
            "description": "Failure summary when `status` is `failed`.",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "UTC expiration timestamp (`YYYY-MM-DDTHH:MM:SSZ`) after which the job is evicted.",
            "type": "string"
          },
          "job_id": {
            "pattern": "^[a-z0-9-]{8,64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "created_at",
          "expires_at"
        ],
        "type": "object"
      },
      "ScanReport": {
        "additionalProperties": true,
        "description": "Machine-readable security report matching `docs/integration/report.schema.json` (`schema_version = \"1\"`).",
        "properties": {
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array"
          },
          "effective_config": {
            "type": "object"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array"
          },
          "project": {
            "type": "object"
          },
          "schema_version": {
            "const": "1",
            "type": "string"
          },
          "stats": {
            "type": "object"
          },
          "tool": {
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "tool",
          "project",
          "stats",
          "effective_config",
          "findings",
          "diagnostics"
        ],
        "type": "object"
      },
      "ScanRequest": {
        "additionalProperties": false,
        "description": "Bounded synchronous scan request payload.",
        "properties": {
          "disabled_rules": {
            "items": {
              "pattern": "^SS-[0-9]{3}$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "enabled_rules": {
            "items": {
              "pattern": "^SS-[0-9]{3}$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/SourceFileInput"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          },
          "max_findings": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "min_confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "min_severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "soroban",
              "generic",
              "auto"
            ],
            "type": "string"
          }
        },
        "required": [
          "files"
        ],
        "type": "object"
      },
      "SourceFileInput": {
        "additionalProperties": false,
        "description": "A single in-memory source file submitted for analysis.",
        "properties": {
          "content": {
            "description": "UTF-8 source or manifest text.",
            "maxLength": 262144,
            "type": "string"
          },
          "path": {
            "description": "Root-relative file path using forward slashes (`src/lib.rs` or `Cargo.toml`). Must not contain `..` or leading slashes.",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "SourceLocation": {
        "additionalProperties": true,
        "description": "1-based source location relative to the scan root.",
        "properties": {
          "column": {
            "minimum": 1,
            "type": "integer"
          },
          "end_column": {
            "minimum": 1,
            "type": "integer"
          },
          "end_line": {
            "minimum": 1,
            "type": "integer"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file",
          "line"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Opt-in bearer token configured by the operator. Compared in constant time and never logged or echoed.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "soroban-scan",
      "url": "https://github.com/AyinkxLab/soroban-security-scanner"
    },
    "description": "Machine-readable OpenAPI 3.1.0 contract for the opt-in `soroban-scan` HTTP service. The service binds to loopback by default, enforces bearer authentication and per-token rate limits, caps payload and job-store sizes, never executes scanned code, and never exposes internal endpoints or secrets.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "summary": "Opt-in, bounded HTTP API contract for deterministic Soroban security analysis.",
    "title": "Soroban Security Scanner HTTP API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Returns service readiness and the deterministic scanner version. Does not require authentication and performs no disk or network I/O.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [],
        "summary": "Check service health and scanner version",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/jobs": {
      "post": {
        "description": "Enqueues a bounded scan request in the job store and returns a job identifier and initial status (`queued`). Rejects new submissions with HTTP 503 when the bounded job store is at capacity.",
        "operationId": "submitScanJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanJobStatus"
                }
              }
            },
            "description": "Scan job accepted and queued.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Submit an asynchronous scan job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "description": "Returns the current lifecycle status (`queued`, `running`, `done`, or `failed`) and timestamps for a submitted scan job. Expired or unknown jobs return HTTP 404.",
        "operationId": "getScanJob",
        "parameters": [
          {
            "description": "Bounded job identifier returned by `POST /v1/jobs`.",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{8,64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanJobStatus"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get scan job status",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/jobs/{job_id}/report": {
      "get": {
        "description": "Returns the deterministic JSON scan report once the job reaches the `done` state. Jobs that are still running, failed, or expired return a structured `ApiError`.",
        "operationId": "getScanJobReport",
        "parameters": [
          {
            "description": "Bounded job identifier returned by `POST /v1/jobs`.",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{8,64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanReport"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fetch the report for a completed scan job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/rules": {
      "get": {
        "description": "Returns all registered security detectors ordered by rule ID, including default severity, confidence, and category.",
        "operationId": "listRules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleListResponse"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List available security rules",
        "tags": [
          "rules"
        ]
      }
    },
    "/v1/rules/{rule_id}": {
      "get": {
        "description": "Returns full rule metadata, description, remediation guidance, and reference URLs for a single detector (`SS-###`).",
        "operationId": "getRule",
        "parameters": [
          {
            "description": "Stable rule identifier (for example `SS-001`).",
            "in": "path",
            "name": "rule_id",
            "required": true,
            "schema": {
              "pattern": "^SS-[0-9]{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuleDetail"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Explain a security rule by ID",
        "tags": [
          "rules"
        ]
      }
    },
    "/v1/scan": {
      "post": {
        "description": "Analyzes a bounded set of in-memory Rust/Soroban source files with the deterministic rule engine and returns a JSON report conforming to the stable report schema. Scanned code is never compiled or executed.",
        "operationId": "runScan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanReport"
                }
              }
            },
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
