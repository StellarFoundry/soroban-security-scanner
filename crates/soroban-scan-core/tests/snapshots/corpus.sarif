                "confidence": "medium",
                "references": [
                  "https://developers.stellar.org/docs/learn/encyclopedia/storage/persisting-data",
                  "https://developers.stellar.org/docs/learn/encyclopedia/security"
                ],
                "remediation": "Reject or truncate values above an explicit maximum before persisting them (for example `if value.len() > MAX { return Err(...) }`). Storing a fixed-size hash instead of the raw value is usually safer.",
                "severity": "medium"
              },
              "shortDescription": {
                "text": "Unbounded string/bytes persisted from caller input"
              }
